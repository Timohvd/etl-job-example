# Copy to `.env` and fill in. `.env` is gitignored: never commit real secrets.
# docker-compose.yml reads these with ${NAME} substitution.
# Generate secrets:   openssl rand -hex 16                                  (passwords)
#                     openssl rand -base64 32 | tr '+/' '-_'                (AIRFLOW_FERNET_KEY)
#                     openssl rand -hex 32                                  (AIRFLOW_SECRET_KEY)
# Use hex passwords: they are safe inside connection URLs (no special characters).

# --- PostgreSQL ---
DB_NAME=project_db
# Admin account: bootstrap, migrations and manual maintenance (e.g. DBeaver). The pipeline never uses it.
PG_ADMIN_USER=elt_admin
PG_ADMIN_PASSWORD=<generate>
# One role per component, created on first start (sql/init/00_bootstrap.sh):
LOADER_PASSWORD=<generate>        # Airflow extract tasks (write raw)
DBT_PASSWORD=<generate>           # dbt (read raw, build staging + production)
READER_PASSWORD=<generate>        # read-only on production, for future APIs / BI
AIRFLOW_DB_PASSWORD=<generate>    # Airflow's own metadata database

# --- Airflow ---
AIRFLOW_UID=1000
AIRFLOW_GID=0
AIRFLOW_ADMIN_PASSWORD=<generate>     # UI login for user "admin"; only applied when the user is first created
AIRFLOW_FERNET_KEY=<generate>
AIRFLOW_SECRET_KEY=<generate>

# --- NS API ---
# Subscription key from https://apiportal.ns.nl/ (sent in the Ocp-Apim-Subscription-Key header).
NS_API_KEY=<ns_api_subscription_key>

# --- Alerts ---
# Recipient of failure and success emails. Leave empty to skip alerts.
ALERT_EMAIL=you@example.com
# MailHog (local fake mail server, UI on http://localhost:8025). Replace for real email (and enable TLS).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_MAIL_FROM=airflow@localhost
# Optional dead man's switch: a healthchecks.io-style URL pinged after every successful run.
HEALTHCHECK_URL=

# --- Optional host ports (defaults shown) ---
# POSTGRES_HOST_PORT=5432
# AIRFLOW_HOST_PORT=8080
